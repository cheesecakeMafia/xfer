# xfer example config

# All known machines in your topology
MACHINES=(workstation laptop server)

# Per-machine SSH settings
workstation_user="alice"
workstation_ip=""
workstation_ssh_key=""

laptop_user="bob"
laptop_ip="100.64.0.2"
laptop_ssh_key="~/.ssh/id_ed25519"

server_user="charlie"
server_ip="100.64.0.3"
server_ssh_key="~/.ssh/id_ed25519"

# This host's machine name
THIS_MACHINE="workstation"

# Machines this host can reach over SSH
CAN_SSH_TO="laptop server"

# Default rsync flags
RSYNC_DEFAULT_FLAGS="-a -v -z --progress --partial --human-readable --protect-args"

# Ceiling on how many items a single --mirror run may delete before it aborts.
# Guards against a mistyped path or an unmounted source emptying a destination.
# Override per-run with --max-delete <n>.
MIRROR_MAX_DELETE="5000"
