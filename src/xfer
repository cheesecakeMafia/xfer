}

cmd_diff() {
  local src_kind=""
  local src_machine=""
  local src_path=""
  local dst_kind=""
  local dst_machine=""
  local dst_path=""
  local resolved_source=""
  local resolved_destination=""
  local remote_machine=""
  local profile=""
  local profile_path=""
  local pattern=""
  local arg=""
  local -a cmd=(rsync)
  local -a defaults=()
  local rsync_exit=0
  local diff_log=""
  local line=""
  local cleanup_git_exclude=false
  local root_dir=""
  local gitignore_path=""
  local remote_gitignore_content=""

  load_config
  ensure_runtime_requirements
  parse_diff_args "$@"

  parse_endpoint "$SOURCE_ENDPOINT"
  src_kind="$PARSED_KIND"
  src_machine="$PARSED_MACHINE"
  src_path="$PARSED_PATH"

  parse_endpoint "$DEST_ENDPOINT"
  dst_kind="$PARSED_KIND"
  dst_machine="$PARSED_MACHINE"
  dst_path="$PARSED_PATH"

  [[ "$src_kind" != "multi" ]] || die "all: is not valid as a diff source"
  [[ "$dst_kind" != "multi" ]] || die "all: is not valid as a diff destination"

  if [[ "$src_kind" == "remote" && "$dst_kind" == "remote" ]]; then
    die "Remote-to-remote diff is not supported. Pull one side locally first."
  fi

  if [[ "$src_kind" == "remote" ]]; then
    machine_reachable "$src_machine" || die "Machine '$src_machine' is not reachable from '$THIS_MACHINE'. Allowed: $CAN_SSH_TO"
    remote_machine="$src_machine"
    resolved_source="$(resolve_remote_spec "$src_machine" "$src_path")"
    resolved_destination="$(expand_tilde "$dst_path")"
  elif [[ "$dst_kind" == "remote" ]]; then
    machine_reachable "$dst_machine" || die "Machine '$dst_machine' is not reachable from '$THIS_MACHINE'. Allowed: $CAN_SSH_TO"
    remote_machine="$dst_machine"
    resolved_source="$(expand_tilde "$src_path")"
    resolved_destination="$(resolve_remote_spec "$dst_machine" "$dst_path")"
  else
    resolved_source="$(expand_tilde "$src_path")"
    resolved_destination="$(expand_tilde "$dst_path")"
  fi

  read -r -a defaults <<< "$RSYNC_DEFAULT_FLAGS"
  cmd+=("${defaults[@]}")

  if [[ "$NO_PROGRESS" == true ]]; then
    local -a filtered=()
    for arg in "${cmd[@]}"; do
      [[ "$arg" == "--progress" ]] && continue
      filtered+=("$arg")
    done
    cmd=("${filtered[@]}")
  fi

  cmd+=(--dry-run --itemize-changes)
  [[ "$QUIET" == true ]] && cmd+=(--quiet)

  GIT_EXCLUDE_FROM_FILE=""
  cleanup_git_exclude=false
  if [[ "$GIT_IGNORE" == true ]]; then
    if [[ "$src_kind" == "local" ]]; then
      root_dir="$(expand_tilde "$src_path")"
      root_dir="${root_dir%/}"
      if [[ -d "$root_dir" ]]; then
        gitignore_path="$root_dir/.gitignore"
        GIT_EXCLUDE_FROM_FILE="$(gitignore_prepare_exclude_file_local "$gitignore_path")" || return 1
        [[ -n "$GIT_EXCLUDE_FROM_FILE" ]] && cleanup_git_exclude=true
      fi
    else
      remote_gitignore_content=""
      if remote_gitignore_content="$(fetch_remote_gitignore "$src_machine" "$src_path")"; then
        if [[ -n "$remote_gitignore_content" ]]; then
          GIT_EXCLUDE_FROM_FILE="$(printf '%s' "$remote_gitignore_content" | gitignore_write_exclude_file_from_stdin)" || return 1
          [[ -n "$GIT_EXCLUDE_FROM_FILE" ]] && cleanup_git_exclude=true
        fi
      else
        die "Failed to read remote .gitignore from '$src_machine:$src_path'"
      fi
    fi
  fi

  if [[ -n "${GIT_EXCLUDE_FROM_FILE:-}" ]]; then
    cmd+=(--exclude-from="$GIT_EXCLUDE_FROM_FILE")
  fi

  for profile in "${EXCLUDE_PROFILES[@]}"; do
    profile_path="$EXCLUDE_PROFILES_DIR/$profile"
    [[ -f "$profile_path" ]] || die "Exclude profile not found: $profile. Available profiles: $(available_exclude_profiles_csv)"
    cmd+=(--exclude-from="$profile_path")
  done

  for pattern in "${EXCLUDES[@]}"; do
    cmd+=(--exclude="$pattern")
  done

  if [[ -n "$remote_machine" ]]; then
    local key
    key="$(resolve_ssh_key "$remote_machine")"
    if [[ -n "$key" ]]; then
      [[ -f "$key" ]] || die "SSH key not found for '$remote_machine': $key"
      cmd+=(-e "ssh -i $key")
    fi
  fi

  cmd+=("$resolved_source" "$resolved_destination")

  if [[ "$VERBOSE" == true ]]; then
    print_verbose_command "${cmd[@]}"
  fi

  diff_log="$(mktemp)"
  "${cmd[@]}" >"$diff_log"
  rsync_exit=$?
  if [[ "$QUIET" != true ]]; then
    while IFS= read -r line; do
      print_diff_item_line "$line"
    done < "$diff_log"
  fi
  rm -f "$diff_log"
  if [[ "$cleanup_git_exclude" == true && -n "${GIT_EXCLUDE_FROM_FILE:-}" ]]; then
    rm -f "$GIT_EXCLUDE_FROM_FILE" 2>/dev/null || true
  fi

  map_rsync_exit "$rsync_exit"

  case "$MAPPED_STATUS" in
    OK)
      return 0
      ;;
    PARTIAL)
      return 23
      ;;
    *)
      return 1
      ;;
  esac
}

cmd_history() {
  local count="${1:-10}"
  local ts=""
  local status=""
  local src=""
  local dst=""
  local files=""
  local bytes=""
  local duration=""
  local flags_b64=""
  local pretty_flags=""

  if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
    print_history_help
    return 0
  fi
  [[ $# -le 1 ]] || die "Usage: xfer history [N]"

  load_config

  if [[ ! -f "$HISTORY_FILE" ]]; then
    print_info "No transfer history yet."
    return 0
  fi

  if ! [[ "$count" =~ ^[0-9]+$ ]]; then
    die "history count must be numeric"
  fi

  printf '%-20s %-7s %-30s %-30s %-8s %s\n' "WHEN" "STATUS" "FROM" "TO" "SIZE" "FLAGS"
  while IFS=$'\t' read -r ts status src dst files bytes duration flags_b64; do
    pretty_flags="$(decode_flags_b64_pretty "$flags_b64")"
    printf '%-20s %-7s %-30s %-30s %-8s %s\n' "$ts" "$status" "$src" "$dst" "$bytes" "$pretty_flags"
  done < <(tail -n "$count" "$HISTORY_FILE")
}

cmd_last() {
  if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
    print_last_help
    return 0
  fi
  [[ $# -eq 0 ]] || die "Usage: xfer last"

  local line=""
  local ts=""
  local status=""
  local src=""
  local dst=""
  local files=""
  local bytes=""
  local duration=""
  local flags_b64=""

  load_config

  [[ -f "$HISTORY_FILE" ]] || die "No transfer history yet."
  line="$(tail -n 1 "$HISTORY_FILE")"
  [[ -n "$line" ]] || die "No transfer history yet."

  IFS=$'\t' read -r ts status src dst files bytes duration flags_b64 <<< "$line"
  [[ -n "$src" && -n "$dst" ]] || die "Malformed history entry"

  if ! decode_flags_b64_to_array "$flags_b64"; then
    die "Failed to decode stored flags in history"
  fi

  print_info "Repeating last transfer: $src -> $dst"
  cmd_transfer "${DECODED_FLAGS[@]}" "$src" "$dst"
}

cmd_undo() {
  if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
    print_undo_help
    return 0
  fi
  [[ $# -eq 0 ]] || die "Usage: xfer undo"

  local line=""
  local found=false
  local ts=""
  local status=""
  local src=""
  local dst=""
  local files=""
  local bytes=""
  local duration=""
  local flags_b64=""
  local response=""

  load_config

  [[ -f "$HISTORY_FILE" ]] || die "No transfer history yet."

  while IFS=$'\t' read -r ts status src dst files bytes duration flags_b64; do
    if [[ "$status" == "OK" || "$status" == "PARTIAL" ]]; then
      found=true
      break
    fi
  done < <(tac "$HISTORY_FILE")

  [[ "$found" == true ]] || die "No reversible history entry found (need OK or PARTIAL)."

  if ! decode_flags_b64_to_array "$flags_b64"; then
    die "Failed to decode stored flags in history"
  fi

  print_warn "Note: undo is a reverse sync, not a true rollback."
  print_info "Reverse sync: $dst -> $src (adds --update)"
  printf 'Continue? [y/N] '
  read -r response
  case "$response" in
    y|Y|yes|YES)
      ;;
    *)
      print_info "Undo cancelled."
      return 0
      ;;
  esac

  cmd_transfer "${DECODED_FLAGS[@]}" --update "$dst" "$src"
}

doctor_ensure_dir() {
  local label="$1"
  local dir_path="$2"
  local apply_fixes="$3"

  if [[ -d "$dir_path" ]]; then
    doctor_ok "$label exists: $dir_path"
    return 0
  fi

  if [[ "$apply_fixes" == true ]]; then
    if mkdir -p "$dir_path"; then
      doctor_fixed "$label created: $dir_path"
      return 0
    fi
  fi

  doctor_fail_msg "$label missing: $dir_path"
  return 1
}

doctor_ensure_file() {
  local label="$1"
  local file_path="$2"
  local apply_fixes="$3"

  if [[ -f "$file_path" ]]; then
    doctor_ok "$label exists: $file_path"
    return 0
  fi

  if [[ "$apply_fixes" == true ]]; then
    if : > "$file_path"; then
      doctor_fixed "$label created: $file_path"
      return 0
    fi
  fi

  doctor_fail_msg "$label missing: $file_path"
  return 1
}

doctor_write_default_profile() {
  local profile_name="$1"
  local profile_path="$2"

  case "$profile_name" in
    dev)
      cat > "$profile_path" <<'PROFILE'
node_modules
.git
__pycache__
.venv
*.pyc
dist
build
.next
.cache
.tox
*.egg-info
PROFILE
      ;;
    media)
      cat > "$profile_path" <<'PROFILE'
*.mp4
*.mkv
*.avi
*.mov
*.iso
*.zip
*.tar.gz
*.rar
PROFILE
      ;;
    *)
      return 1
      ;;
  esac
  return 0
}

doctor_ensure_default_profile() {
  local profile_name="$1"
  local apply_fixes="$2"
  local profile_path="$EXCLUDE_PROFILES_DIR/$profile_name"

  if [[ -f "$profile_path" ]]; then
    doctor_ok "exclude profile '$profile_name' exists"
    return 0
  fi

  if [[ "$apply_fixes" == true ]]; then
    if doctor_write_default_profile "$profile_name" "$profile_path"; then
      doctor_fixed "exclude profile '$profile_name' created"
      return 0
    fi
  fi

  doctor_fail_msg "exclude profile '$profile_name' missing"
  return 1
}

doctor_check_config_mode() {
  local apply_fixes="$1"
  local mode=""

  if [[ ! -f "$CONFIG_PATH" ]]; then
    doctor_fail_msg "config file missing: $CONFIG_PATH"
    return 1
  fi

  mode="$(stat -c '%a' "$CONFIG_PATH" 2>/dev/null || true)"
  if [[ "$mode" == "600" ]]; then
    doctor_ok "config permissions are 600"
    return 0
  fi

  if [[ "$apply_fixes" == true ]]; then
    if chmod 600 "$CONFIG_PATH"; then
      doctor_fixed "config permissions set to 600"
      return 0
    fi
  fi

  doctor_fail_msg "config permissions should be 600 (current: ${mode:-unknown})"
  return 1
}

doctor_check_required_commands() {
  local cmd=""
  local -a required=(bash rsync ssh flock base64)

  for cmd in "${required[@]}"; do
    if command_exists "$cmd"; then
      doctor_ok "required command available: $cmd"
    else
      doctor_fail_msg "required command missing: $cmd"
    fi
  done
}

doctor_check_config_semantics() {
  local machine=""

  if [[ ${#CAN_SSH_TO_ARR[@]} -eq 0 ]]; then
    doctor_fail_msg "CAN_SSH_TO has no reachable targets"
  else
    doctor_ok "CAN_SSH_TO has targets: $CAN_SSH_TO"
  fi

  for machine in "${CAN_SSH_TO_ARR[@]}"; do
    if ! machine_exists "$machine"; then
      doctor_fail_msg "CAN_SSH_TO contains unknown machine: $machine"
      continue
    fi
    if [[ "$machine" == "$THIS_MACHINE" ]]; then
      doctor_fail_msg "CAN_SSH_TO should not include THIS_MACHINE ($THIS_MACHINE)"
      continue
    fi
    doctor_ok "reachable machine configured: $machine"
  done
}

doctor_check_history_and_bookmarks() {
  local line_no=0
  local ts=""
  local status=""
  local src=""
  local dst=""
  local files=""
  local bytes=""
  local duration=""
  local flags_b64=""
  local bookmark_file=""
  local bookmark_name=""
  local has_bookmark=false

  if [[ -f "$HISTORY_FILE" ]]; then
    while IFS=$'\t' read -r ts status src dst files bytes duration flags_b64; do
      line_no=$((line_no + 1))
      if [[ -z "$ts" || -z "$status" || -z "$src" || -z "$dst" || -z "$duration" ]]; then
        doctor_fail_msg "history line $line_no malformed"
        return 1
      fi
      if [[ -n "$flags_b64" ]] && command_exists base64 && ! decode_flags_b64_to_array "$flags_b64"; then
        doctor_fail_msg "history line $line_no has invalid encoded flags"
        return 1
      fi
    done < "$HISTORY_FILE"
    doctor_ok "history file format is valid"
  fi

  for bookmark_file in "$BOOKMARKS_DIR"/*; do
    [[ -f "$bookmark_file" ]] || continue
    bookmark_name="$(basename "$bookmark_file")"
    [[ "$bookmark_name" == ".lock" ]] && continue
    has_bookmark=true

    {
      read -r src || true
      read -r dst || true
      read -r flags_b64 || true
    } < "$bookmark_file"

    if [[ -z "$src" || -z "$dst" ]]; then
      doctor_fail_msg "bookmark '$bookmark_name' is malformed"
      return 1
    fi
    if [[ -n "$flags_b64" ]] && command_exists base64 && ! decode_flags_b64_to_array "$flags_b64"; then
      doctor_fail_msg "bookmark '$bookmark_name' has invalid encoded flags"
      return 1
    fi
  done

  if [[ "$has_bookmark" == true ]]; then
    doctor_ok "bookmark files are well-formed"
  else
    doctor_warn "no bookmarks saved yet"
  fi

  return 0
}

doctor_check_remote_connectivity() {
  local machine=""
  local user=""
  local ip=""
  local key=""
  local -a ssh_cmd=()

  if ! command_exists ssh; then
    doctor_fail_msg "ssh command is missing; remote checks cannot run"
    return 1
  fi

  for machine in "${CAN_SSH_TO_ARR[@]}"; do
    machine_exists "$machine" || continue

    user="$(machine_field "$machine" user)"
    ip="$(machine_field "$machine" ip)"
    key="$(resolve_ssh_key "$machine")"

    if [[ -z "$user" || -z "$ip" ]]; then
      doctor_fail_msg "missing user/ip for reachable machine '$machine'"
      continue
    fi

    ssh_cmd=(ssh -o BatchMode=yes -o ConnectTimeout=5)
    if [[ -n "$key" ]]; then
      if [[ ! -f "$key" ]]; then
        doctor_fail_msg "ssh key for '$machine' not found: $key"
        continue
      fi
      ssh_cmd+=(-i "$key")
      doctor_ok "ssh key file exists for '$machine'"
    else
      doctor_warn "no ssh key configured for '$machine' (agent/default key must work)"
    fi
    ssh_cmd+=("$user@$ip")

    if "${ssh_cmd[@]}" true >/dev/null 2>&1; then
      doctor_ok "ssh reachable: $machine ($user@$ip)"
    else
      doctor_fail_msg "ssh unreachable: $machine ($user@$ip)"
      continue
    fi

    if "${ssh_cmd[@]}" 'command -v rsync >/dev/null 2>&1' >/dev/null 2>&1; then
      doctor_ok "remote rsync available: $machine"
    else
      doctor_fail_msg "remote rsync missing on: $machine"
    fi
  done
}

cmd_doctor() {
  local do_fix=false
  local assume_yes=false
  local apply_fixes=false
  local config_loaded=false
  local response=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --fix)
        do_fix=true
        ;;
      --yes)
        assume_yes=true
        ;;
      -h|--help)
        print_doctor_help
        return 0
        ;;
      *)
        die "Unknown doctor option: $1"
        ;;
    esac
    shift
  done

  doctor_reset_counters
  doctor_config_paths_from_config_path
  DATA_DIR="${DATA_DIR:-$HOME/.local/share/xfer}"
  DATA_DIR="$(expand_tilde "$DATA_DIR")"
  HISTORY_FILE="$DATA_DIR/history.log"

  if [[ "$do_fix" == true ]]; then
    if [[ "$assume_yes" == true ]]; then
      apply_fixes=true
    else
      printf 'xfer doctor: apply automatic local fixes? [y/N] '
      read -r response
      case "$response" in
        y|Y|yes|YES) apply_fixes=true ;;
        *)
          print_info "doctor fix actions skipped"
          ;;
      esac
    fi
  elif [[ "$assume_yes" == true ]]; then
    doctor_warn "--yes has no effect without --fix"
  fi

  doctor_check_required_commands

  if [[ -f "$CONFIG_PATH" ]]; then
    doctor_ok "config file exists: $CONFIG_PATH"
  else
    doctor_fail_msg "config file missing: $CONFIG_PATH"
  fi

  if [[ -f "$CONFIG_PATH" && -r "$CONFIG_PATH" ]]; then
    doctor_ok "config file is readable"
  elif [[ -f "$CONFIG_PATH" ]]; then
    doctor_fail_msg "config file is not readable"
  fi

  if doctor_try_load_config; then
    config_loaded=true
    doctor_ok "config parsed successfully"
  else
    config_loaded=false
    doctor_fail_msg "config parse/validation failed"
  fi

  doctor_ensure_dir "config directory" "$CONFIG_DIR" "$apply_fixes"
  doctor_ensure_dir "bookmarks directory" "$BOOKMARKS_DIR" "$apply_fixes"
  doctor_ensure_dir "exclude-profiles directory" "$EXCLUDE_PROFILES_DIR" "$apply_fixes"
  doctor_ensure_dir "data directory" "$DATA_DIR" "$apply_fixes"
  doctor_ensure_file "history file" "$HISTORY_FILE" "$apply_fixes"
  doctor_ensure_default_profile "dev" "$apply_fixes"
  doctor_ensure_default_profile "media" "$apply_fixes"

  if [[ -f "$CONFIG_PATH" ]]; then
    doctor_check_config_mode "$apply_fixes"
  fi

  if [[ "$config_loaded" == true ]]; then
    doctor_check_config_semantics
    doctor_check_history_and_bookmarks
    doctor_check_remote_connectivity
  fi

  print_info "doctor summary: checks=$DOCTOR_TOTAL ok=$DOCTOR_OK fixed=$DOCTOR_FIXED warn=$DOCTOR_WARN fail=$DOCTOR_FAIL"

  if [[ "$DOCTOR_FAIL" -gt 0 ]]; then
    return 1
  fi
  return 0
}

bookmark_file_for() {
  local name="$1"
  printf '%s/%s\n' "$BOOKMARKS_DIR" "$name"
}

validate_bookmark_name() {
  local name="$1"
  [[ "$name" =~ ^[a-zA-Z0-9_-]+$ ]]
}

cmd_bookmark_save() {
  local name="$1"
  local src="$2"
  local dst="$3"
  shift 3
  local -a flag_args=("$@")
  local flags_b64=""
  local bookmark_file=""
  local tmp_file=""

  validate_bookmark_name "$name" || die "Invalid bookmark name '$name' (allowed: letters, digits, _, -)"

  flags_b64="$(encode_flags_b64 "${flag_args[@]}")"
  bookmark_file="$(bookmark_file_for "$name")"

  (
    flock -x 200
    if [[ -f "$bookmark_file" ]]; then
      print_warn "Overwriting existing bookmark: $name"
    fi
    tmp_file="$(mktemp "$BOOKMARKS_DIR/.${name}.tmp.XXXXXX")"
    printf '%s\n%s\n%s\n' "$src" "$dst" "$flags_b64" > "$tmp_file"
    mv "$tmp_file" "$bookmark_file"
  ) 200>"$BOOKMARKS_DIR/.lock"

  print_info "Saved bookmark '$name'"
}

cmd_bookmark_run() {
  local name="$1"
  local bookmark_file=""
  local src=""
  local dst=""
  local flags_b64=""

  bookmark_file="$(bookmark_file_for "$name")"
  [[ -f "$bookmark_file" ]] || die "Bookmark not found: $name"

  {
    read -r src
    read -r dst
    read -r flags_b64
  } < "$bookmark_file"

  if ! decode_flags_b64_to_array "$flags_b64"; then
    die "Bookmark '$name' has invalid encoded flags"
  fi

  print_info "Running bookmark '$name': $src -> $dst"
  cmd_transfer "${DECODED_FLAGS[@]}" "$src" "$dst"
}

cmd_bookmark_list() {
  local bookmark_file=""
  local name=""
  local src=""
  local dst=""

  local found=false
  for bookmark_file in "$BOOKMARKS_DIR"/*; do
    [[ -f "$bookmark_file" ]] || continue
    found=true
    name="$(basename "$bookmark_file")"
    {
      read -r src
      read -r dst
    } < "$bookmark_file"
    printf '%-20s %s -> %s\n' "$name" "$src" "$dst"
  done

  if [[ "$found" == false ]]; then
    print_info "No bookmarks saved yet."
  fi
}

cmd_bookmark_delete() {
  local name="$1"
  local bookmark_file=""

  bookmark_file="$(bookmark_file_for "$name")"

  (
    flock -x 200
    [[ -f "$bookmark_file" ]] || die "Bookmark not found: $name"
    rm "$bookmark_file"
  ) 200>"$BOOKMARKS_DIR/.lock"

  print_info "Deleted bookmark '$name'"
}

cmd_bookmark() {
  local action="${1:-list}"
  shift || true

  load_config

  case "$action" in
    save)
      [[ $# -ge 3 ]] || die "Usage: xfer bookmark save <name> <source> <destination> [flags]"
      cmd_bookmark_save "$@"
      ;;
    run)
      [[ $# -eq 1 ]] || die "Usage: xfer bookmark run <name>"
      cmd_bookmark_run "$1"
      ;;
    list)
      [[ $# -eq 0 ]] || die "Usage: xfer bookmark list"
      cmd_bookmark_list
      ;;
    delete)
      [[ $# -eq 1 ]] || die "Usage: xfer bookmark delete <name>"
      cmd_bookmark_delete "$1"
      ;;
    -h|--help)
      cat <<'HELP'
Usage:
  xfer bookmark save <name> <source> <destination> [flags]
  xfer bookmark run <name>
  xfer bookmark list
  xfer bookmark delete <name>
HELP
      ;;
    *)
      die "Unknown bookmark action: $action"
      ;;
  esac
}

main() {
  setup_colors

  extract_global_options "$@"

  if [[ ${#ARGS[@]} -eq 0 ]]; then
    print_help
    return 0
  fi

  case "${ARGS[0]}" in
    --version)
      printf '%s\n' "$VERSION"
      ;;
    -h|--help)
      print_help
      ;;
    ls)
      cmd_ls "${ARGS[@]:1}"
      ;;
    diff)
      cmd_diff "${ARGS[@]:1}"
      ;;
    history)
      cmd_history "${ARGS[@]:1}"
      ;;
    last)
      cmd_last "${ARGS[@]:1}"
      ;;
    undo)
      cmd_undo "${ARGS[@]:1}"
      ;;
    doctor)
      cmd_doctor "${ARGS[@]:1}"
      ;;
    doc)
      cmd_doctor "${ARGS[@]:1}"
      ;;
    docter)
      cmd_doctor "${ARGS[@]:1}"
      ;;
    bookmark)
      cmd_bookmark "${ARGS[@]:1}"
      ;;
    *)
      cmd_transfer "${ARGS[@]}"
      ;;
  esac
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  main "$@"
fi
