#!/usr/bin/env bash
set -u
set -o pipefail

VERSION="0.1.0"
DEFAULT_CONFIG_PATH="$HOME/.config/xfer/config"

CONFIG_PATH="$DEFAULT_CONFIG_PATH"
CONFIG_DIR=""
EXCLUDE_PROFILES_DIR=""
DATA_DIR=""
BOOKMARKS_DIR=""
HISTORY_FILE=""

THIS_MACHINE=""
CAN_SSH_TO=""
CAN_SSH_TO_ARR=()
MACHINES=()
RSYNC_DEFAULT_FLAGS=""

DRY_RUN=false
VERBOSE=false
QUIET=false
NO_PROGRESS=false
UPDATE=false
GIT_IGNORE=false

SOURCE_ENDPOINT=""
DEST_ENDPOINT=""
TRANSFER_RAW_FLAGS=()
EXCLUDES=()
EXCLUDE_PROFILES=()
GIT_EXCLUDE_FROM_FILE=""

ARGS=()
PARSED_KIND=""
PARSED_MACHINE=""
PARSED_PATH=""
PARSED_TARGETS=()
BUILT_CMD=()
DECODED_FLAGS=()
MAPPED_STATUS=""
MAPPED_EXIT=0
STATS_FILES="-"
STATS_BYTES="-"
DOCTOR_TOTAL=0
DOCTOR_OK=0
DOCTOR_FAIL=0
DOCTOR_WARN=0
DOCTOR_FIXED=0

C_RESET=""
C_RED=""
C_GREEN=""
C_YELLOW=""
C_BLUE=""

setup_colors() {
  if [[ -t 1 && -z "${NO_COLOR:-}" ]]; then
    C_RESET=$'\033[0m'
    C_RED=$'\033[31m'
    C_GREEN=$'\033[32m'
    C_YELLOW=$'\033[33m'
    C_BLUE=$'\033[34m'
  fi
}

print_info() {
  [[ "$QUIET" == true ]] && return 0
  printf '%sxfer:%s %s\n' "$C_BLUE" "$C_RESET" "$*"
}

print_warn() {
  printf '%sxfer:%s %s\n' "$C_YELLOW" "$C_RESET" "$*" >&2
}

print_error() {
  printf '%sxfer:%s %s\n' "$C_RED" "$C_RESET" "$*" >&2
}

die() {
  print_error "$*"
  if [[ -n "${GIT_EXCLUDE_FROM_FILE:-}" && -f "${GIT_EXCLUDE_FROM_FILE:-}" ]]; then
    rm -f "$GIT_EXCLUDE_FROM_FILE" 2>/dev/null || true
  fi
  exit 1
}

expand_tilde() {
  local path="$1"
  if [[ "$path" == "~" ]]; then
    printf '%s\n' "$HOME"
    return
  fi
  if [[ "$path" == "~/"* ]]; then
    printf '%s\n' "$HOME/${path#"~/"}"
    return
  fi
  printf '%s\n' "$path"
}

available_machines_csv() {
  local joined=""
  local machine
  for machine in "${MACHINES[@]}"; do
    if [[ -n "$joined" ]]; then
      joined+=" "
    fi
    joined+="$machine"
  done
  printf '%s\n' "$joined"
}

available_exclude_profiles_csv() {
  local profile_file=""
  local profile_name=""
  local joined=""
  local had_nullglob=0

  if shopt -q nullglob; then
    had_nullglob=1
  fi
  shopt -s nullglob

  for profile_file in "$EXCLUDE_PROFILES_DIR"/*; do
    [[ -f "$profile_file" ]] || continue
    profile_name="$(basename "$profile_file")"
    if [[ -n "$joined" ]]; then
      joined+=" "
    fi
    joined+="$profile_name"
  done

  if [[ "$had_nullglob" -eq 0 ]]; then
    shopt -u nullglob
  fi

  if [[ -z "$joined" ]]; then
    printf '<none>\n'
  else
    printf '%s\n' "$joined"
  fi
}

require_cmd() {
  local cmd="$1"
  command -v "$cmd" >/dev/null 2>&1 || die "Required command not found: $cmd"
}

command_exists() {
  command -v "$1" >/dev/null 2>&1
}

ensure_runtime_requirements() {
  require_cmd rsync
  require_cmd ssh
  require_cmd flock
  require_cmd base64
}

machine_exists() {
  local candidate="$1"
  local machine
  for machine in "${MACHINES[@]}"; do
    if [[ "$machine" == "$candidate" ]]; then
      return 0
    fi
  done
  return 1
}

machine_reachable() {
  local candidate="$1"
  local machine
  for machine in "${CAN_SSH_TO_ARR[@]}"; do
    if [[ "$machine" == "$candidate" ]]; then
      return 0
    fi
  done
  return 1
}

machine_field() {
  local machine="$1"
  local field="$2"
  local var_name="${machine}_${field}"
  printf '%s\n' "${!var_name:-}"
}

normalize_remote_path() {
  local path="$1"
  if [[ -z "$path" || "$path" == "~" || "$path" == "~/" ]]; then
    printf '.\n'
    return
  fi
  if [[ "$path" == "~/"* ]]; then
    printf '%s\n' "${path#"~/"}"
    return
  fi
  printf '%s\n' "$path"
}

gitignore_write_exclude_file_from_stdin() {
  local tmp_file=""
  local line=""
  local trimmed=""
  local had_pattern=false

  tmp_file="$(mktemp)"
  chmod 600 "$tmp_file" 2>/dev/null || true

  while IFS= read -r line || [[ -n "$line" ]]; do
    # Handle CRLF files gracefully.
    line="${line%$'\r'}"

    trimmed="${line#"${line%%[!$' \t']*}"}"
    [[ -n "$trimmed" ]] || continue

    # Comment lines: first non-whitespace is '#'. Allow '\#' as a literal pattern.
    if [[ "${trimmed:0:1}" == "#" ]]; then
      continue
    fi

    # Negation is not supported: first non-whitespace is '!'. Allow '\!' as a literal pattern.
    if [[ "${trimmed:0:1}" == "!" ]]; then
      rm -f "$tmp_file" 2>/dev/null || true
      die "Unsupported .gitignore negation pattern found ('!'). Remove lines starting with '!'."
    fi

    printf '%s\n' "$line" >>"$tmp_file"
    had_pattern=true
  done

  if [[ "$had_pattern" != true ]]; then
    rm -f "$tmp_file" 2>/dev/null || true
    printf '\n'
    return 0
  fi

  printf '%s\n' "$tmp_file"
}

gitignore_prepare_exclude_file_local() {
  local gitignore_path="$1"
  [[ -f "$gitignore_path" ]] || { printf '\n'; return 0; }
  [[ -r "$gitignore_path" ]] || die "Cannot read .gitignore: $gitignore_path"
  gitignore_write_exclude_file_from_stdin <"$gitignore_path"
}

remote_gitignore_file_for_cat() {
  local raw_dir="$1"
  local dir=""
  local file=""

  dir="$(normalize_remote_path "$raw_dir")"
  dir="${dir%/}"

  if [[ "$dir" == "." ]]; then
    file=".gitignore"
  else
    file="$dir/.gitignore"
  fi

  # Quote as a single token for the remote shell.
  printf '%q\n' "$file"
}

fetch_remote_gitignore() {
  local machine="$1"
  local raw_dir="$2"
  local user=""
  local ip=""
  local key=""
  local safe_file=""
  local -a ssh_cmd=()

  user="$(machine_field "$machine" user)"
  ip="$(machine_field "$machine" ip)"
  key="$(resolve_ssh_key "$machine")"

  [[ -n "$user" ]] || die "Missing config value: ${machine}_user"
  [[ -n "$ip" ]] || die "Missing config value: ${machine}_ip"

  ssh_cmd=(ssh -o BatchMode=yes -o ConnectTimeout=5)
  if [[ -n "$key" ]]; then
    [[ -f "$key" ]] || die "SSH key not found for '$machine': $key"
    ssh_cmd+=(-i "$key")
  fi
  ssh_cmd+=("$user@$ip")

  safe_file="$(remote_gitignore_file_for_cat "$raw_dir")"

  # Missing file should be a no-op (empty output). SSH failure should be an error.
  "${ssh_cmd[@]}" "if [ -f $safe_file ]; then cat -- $safe_file; fi"
}

resolve_remote_spec() {
  local machine="$1"
  local path="$2"
  local user
  local ip

  user="$(machine_field "$machine" user)"
  ip="$(machine_field "$machine" ip)"

  [[ -n "$user" ]] || die "Missing config value: ${machine}_user"
  [[ -n "$ip" ]] || die "Missing config value: ${machine}_ip"

  printf '%s@%s:%s\n' "$user" "$ip" "$(normalize_remote_path "$path")"
}

resolve_ssh_key() {
  local machine="$1"
  local key
  key="$(machine_field "$machine" ssh_key)"
  if [[ -z "$key" ]]; then
    printf '\n'
    return
  fi

  # Normalize common accidental form: "$HOME/~/.ssh/key" -> "$HOME/.ssh/key"
  if [[ "$key" == "$HOME/~/"* ]]; then
    key="$HOME/${key#"$HOME/~/"}"
  fi

  expand_tilde "$key"
}

load_config() {
  local expanded

  expanded="$(expand_tilde "$CONFIG_PATH")"
  CONFIG_PATH="$expanded"

  [[ -f "$CONFIG_PATH" ]] || die "Config not found at '$CONFIG_PATH'. Run ./install.sh first or use --config <path>."

  # shellcheck disable=SC1090
  source "$CONFIG_PATH"

  if [[ ${#MACHINES[@]} -eq 0 ]]; then
    die "Config error: MACHINES is empty"
  fi
  [[ -n "${THIS_MACHINE:-}" ]] || die "Config error: THIS_MACHINE is not set"
  [[ -n "${CAN_SSH_TO:-}" ]] || die "Config error: CAN_SSH_TO is not set"

  machine_exists "$THIS_MACHINE" || die "Config error: THIS_MACHINE '$THIS_MACHINE' is not in MACHINES"

  CONFIG_DIR="$(dirname "$CONFIG_PATH")"
  CONFIG_DIR="$(expand_tilde "$CONFIG_DIR")"
  EXCLUDE_PROFILES_DIR="$CONFIG_DIR/exclude-profiles"
  BOOKMARKS_DIR="$CONFIG_DIR/bookmarks"

  DATA_DIR="${DATA_DIR:-$HOME/.local/share/xfer}"
  DATA_DIR="$(expand_tilde "$DATA_DIR")"
  HISTORY_FILE="$DATA_DIR/history.log"

  RSYNC_DEFAULT_FLAGS="${RSYNC_DEFAULT_FLAGS:--a -v -z --progress --partial --human-readable --protect-args}"
  if [[ " $RSYNC_DEFAULT_FLAGS " != *" --protect-args "* && " $RSYNC_DEFAULT_FLAGS " != *" -s "* ]]; then
    RSYNC_DEFAULT_FLAGS+=" --protect-args"
  fi

  read -r -a CAN_SSH_TO_ARR <<< "$CAN_SSH_TO"

  mkdir -p "$EXCLUDE_PROFILES_DIR" "$BOOKMARKS_DIR" "$DATA_DIR"
}

doctor_reset_counters() {
  DOCTOR_TOTAL=0
  DOCTOR_OK=0
  DOCTOR_FAIL=0
  DOCTOR_WARN=0
  DOCTOR_FIXED=0
}

doctor_ok() {
  DOCTOR_TOTAL=$((DOCTOR_TOTAL + 1))
  DOCTOR_OK=$((DOCTOR_OK + 1))
  printf '%s[OK]%s %s\n' "$C_GREEN" "$C_RESET" "$1"
}

doctor_warn() {
  DOCTOR_TOTAL=$((DOCTOR_TOTAL + 1))
  DOCTOR_WARN=$((DOCTOR_WARN + 1))
  printf '%s[WARN]%s %s\n' "$C_YELLOW" "$C_RESET" "$1"
}

doctor_fail_msg() {
  DOCTOR_TOTAL=$((DOCTOR_TOTAL + 1))
  DOCTOR_FAIL=$((DOCTOR_FAIL + 1))
  printf '%s[FAIL]%s %s\n' "$C_RED" "$C_RESET" "$1"
}

doctor_fixed() {
  DOCTOR_TOTAL=$((DOCTOR_TOTAL + 1))
  DOCTOR_FIXED=$((DOCTOR_FIXED + 1))
  printf '%s[FIXED]%s %s\n' "$C_GREEN" "$C_RESET" "$1"
}

doctor_config_paths_from_config_path() {
  local expanded_path=""
  expanded_path="$(expand_tilde "$CONFIG_PATH")"
  CONFIG_PATH="$expanded_path"
  CONFIG_DIR="$(dirname "$CONFIG_PATH")"
  EXCLUDE_PROFILES_DIR="$CONFIG_DIR/exclude-profiles"
  BOOKMARKS_DIR="$CONFIG_DIR/bookmarks"
}

doctor_try_load_config() {
  local expanded=""
  local source_rc=0

  expanded="$(expand_tilde "$CONFIG_PATH")"
  CONFIG_PATH="$expanded"

  if [[ ! -f "$CONFIG_PATH" ]]; then
    return 1
  fi

  set +u
  # shellcheck disable=SC1090
  source "$CONFIG_PATH" || source_rc=$?
  set -u
  if [[ "$source_rc" -ne 0 ]]; then
    return 1
  fi

  if ! declare -p MACHINES >/dev/null 2>&1; then
    return 1
  fi
  [[ ${#MACHINES[@]} -gt 0 ]] || return 1
  [[ -n "${THIS_MACHINE:-}" ]] || return 1
  [[ -n "${CAN_SSH_TO:-}" ]] || return 1

  if ! machine_exists "$THIS_MACHINE"; then
    return 1
  fi

  CONFIG_DIR="$(dirname "$CONFIG_PATH")"
  EXCLUDE_PROFILES_DIR="$CONFIG_DIR/exclude-profiles"
  BOOKMARKS_DIR="$CONFIG_DIR/bookmarks"
  DATA_DIR="${DATA_DIR:-$HOME/.local/share/xfer}"
  DATA_DIR="$(expand_tilde "$DATA_DIR")"
  HISTORY_FILE="$DATA_DIR/history.log"

  RSYNC_DEFAULT_FLAGS="${RSYNC_DEFAULT_FLAGS:--a -v -z --progress --partial --human-readable --protect-args}"
  if [[ " $RSYNC_DEFAULT_FLAGS " != *" --protect-args "* && " $RSYNC_DEFAULT_FLAGS " != *" -s "* ]]; then
    RSYNC_DEFAULT_FLAGS+=" --protect-args"
  fi

  read -r -a CAN_SSH_TO_ARR <<< "$CAN_SSH_TO"
  return 0
}

extract_global_options() {
  local -a filtered=()

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --config)
        shift
        [[ $# -gt 0 ]] || die "--config requires a value"
        CONFIG_PATH="$1"
        ;;
      --config=*)
        CONFIG_PATH="${1#*=}"
        ;;
      *)
        filtered+=("$1")
        ;;
    esac
    shift || true
  done

  ARGS=("${filtered[@]}")
}

parse_endpoint() {
  local endpoint="$1"
  local prefix=""
  local rest=""
  local machine=""
  local -A seen_targets=()
  local -a raw_targets=()

  PARSED_KIND=""
  PARSED_MACHINE=""
  PARSED_PATH=""
  PARSED_TARGETS=()

  if [[ "$endpoint" == /* || "$endpoint" == ./* || "$endpoint" == ~* ]]; then
    PARSED_KIND="local"
    PARSED_PATH="$endpoint"
    return
  fi

  if [[ "$endpoint" != *:* ]]; then
    PARSED_KIND="local"
    PARSED_PATH="$endpoint"
    return
  fi

  prefix="${endpoint%%:*}"
  rest="${endpoint#*:}"

  if [[ "$prefix" == "all" ]]; then
    PARSED_KIND="multi"
    PARSED_PATH="$rest"

    if [[ ${#CAN_SSH_TO_ARR[@]} -gt 0 ]]; then
      for machine in "${CAN_SSH_TO_ARR[@]}"; do
        machine_exists "$machine" || die "Config error: CAN_SSH_TO references unknown machine '$machine'"
        if [[ -z "${seen_targets[$machine]:-}" ]]; then
          PARSED_TARGETS+=("$machine")
          seen_targets[$machine]=1
        fi
      done
    else
      for machine in "${MACHINES[@]}"; do
        if [[ "$machine" != "$THIS_MACHINE" ]]; then
          PARSED_TARGETS+=("$machine")
        fi
      done
    fi
    return
  fi

  if [[ "$prefix" == *,* ]]; then
    IFS=',' read -r -a raw_targets <<< "$prefix"
    for machine in "${raw_targets[@]}"; do
      [[ -n "$machine" ]] || die "Invalid multi-target endpoint: '$endpoint'"
      machine_exists "$machine" || die "Unknown machine '$machine'. Available: $(available_machines_csv)"
      if [[ -z "${seen_targets[$machine]:-}" ]]; then
        PARSED_TARGETS+=("$machine")
        seen_targets[$machine]=1
      fi
    done
    PARSED_KIND="multi"
    PARSED_PATH="$rest"
    return
  fi

  if machine_exists "$prefix"; then
    PARSED_KIND="remote"
    PARSED_MACHINE="$prefix"
    PARSED_PATH="$rest"
    return
  fi

  die "Unknown machine prefix '$prefix'. Use ./, /, or ~ for local paths with ':'. Available machines: $(available_machines_csv)"
}

encode_flags_b64() {
  if [[ $# -eq 0 ]]; then
    printf '\n'
    return
  fi
  printf '%s\0' "$@" | base64 -w0
  printf '\n'
}

decode_flags_b64_to_array() {
  local encoded="$1"
  DECODED_FLAGS=()

  if [[ -z "$encoded" ]]; then
    return 0
  fi

  if ! mapfile -d '' -t DECODED_FLAGS < <(printf '%s' "$encoded" | base64 -d 2>/dev/null); then
    return 1
  fi

  return 0
}

decode_flags_b64_pretty() {
  local encoded="$1"
  local pretty=""

  if [[ -z "$encoded" ]]; then
    printf '\n'
    return 0
  fi

  if ! decode_flags_b64_to_array "$encoded"; then
    printf '<invalid-flags>\n'
    return 1
  fi

  if [[ ${#DECODED_FLAGS[@]} -eq 0 ]]; then
    printf '\n'
    return 0
  fi

  printf -v pretty '%q ' "${DECODED_FLAGS[@]}"
  printf '%s\n' "${pretty% }"
}

map_rsync_exit() {
  local rsync_exit="$1"
  case "$rsync_exit" in
    0|24)
      MAPPED_STATUS="OK"
      MAPPED_EXIT=0
      ;;
    23)
      MAPPED_STATUS="PARTIAL"
      MAPPED_EXIT=23
      ;;
    *)
      MAPPED_STATUS="FAIL"
      MAPPED_EXIT=1
      ;;
  esac
}

record_history() {
  local status="$1"
  local src="$2"
  local dst="$3"
  local files="$4"
  local bytes="$5"
  local duration="$6"
  local flags_b64="$7"
  local timestamp

  timestamp="$(date -Iseconds)"

  (
    flock -x 200
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
      "$timestamp" "$status" "$src" "$dst" "$files" "$bytes" "$duration" "$flags_b64" \
      >> "$HISTORY_FILE"
  ) 200>"$DATA_DIR/history.log.lock"
}

extract_transfer_stats() {
  local stats_file="$1"
  local files_line=""
  local bytes_line=""

  STATS_FILES="-"
  STATS_BYTES="-"

  files_line="$(sed -n 's/^Number of regular files transferred: \([0-9][0-9,]*\)$/\1/p' "$stats_file" | tail -n 1)"
  if [[ -z "$files_line" ]]; then
    files_line="$(sed -n 's/^Number of files transferred: \([0-9][0-9,]*\)$/\1/p' "$stats_file" | tail -n 1)"
  fi
  if [[ -n "$files_line" ]]; then
    STATS_FILES="${files_line//,/}"
  fi

  bytes_line="$(sed -n 's/^Total transferred file size: \(.*\)$/\1/p' "$stats_file" | tail -n 1)"
  if [[ -z "$bytes_line" ]]; then
    bytes_line="$(sed -n 's/^Total file size: \(.*\)$/\1/p' "$stats_file" | tail -n 1)"
  fi
  if [[ -n "$bytes_line" ]]; then
    STATS_BYTES="$bytes_line"
  fi
}

build_rsync_cmd() {
  local remote_machine="$1"
  local resolved_source="$2"
  local resolved_destination="$3"
  local ssh_key=""
  local profile=""
  local profile_path=""
  local pattern=""
  local arg=""
  local -a cmd=(rsync)
  local -a default_flags=()

  read -r -a default_flags <<< "$RSYNC_DEFAULT_FLAGS"
  cmd+=("${default_flags[@]}")

  if [[ "$NO_PROGRESS" == true ]]; then
    local -a filtered=()
    for arg in "${cmd[@]}"; do
      [[ "$arg" == "--progress" ]] && continue
      filtered+=("$arg")
    done
    cmd=("${filtered[@]}")
  fi

  [[ "$DRY_RUN" == true ]] && cmd+=(--dry-run)
  [[ "$UPDATE" == true ]] && cmd+=(--update)
  [[ "$QUIET" == true ]] && cmd+=(--quiet)
  [[ "$DRY_RUN" != true ]] && cmd+=(--stats)

  if [[ "$GIT_IGNORE" == true && -n "${GIT_EXCLUDE_FROM_FILE:-}" ]]; then
    cmd+=(--exclude-from="$GIT_EXCLUDE_FROM_FILE")
  fi

  for profile in "${EXCLUDE_PROFILES[@]}"; do
    profile_path="$EXCLUDE_PROFILES_DIR/$profile"
    [[ -f "$profile_path" ]] || die "Exclude profile not found: $profile. Available profiles: $(available_exclude_profiles_csv)"
    cmd+=(--exclude-from="$profile_path")
  done

  for pattern in "${EXCLUDES[@]}"; do
    cmd+=(--exclude="$pattern")
  done

  if [[ -n "$remote_machine" ]]; then
    ssh_key="$(resolve_ssh_key "$remote_machine")"
    if [[ -n "$ssh_key" ]]; then
      [[ -f "$ssh_key" ]] || die "SSH key not found for '$remote_machine': $ssh_key"
      cmd+=(-e "ssh -i $ssh_key")
    fi
  fi

  cmd+=("$resolved_source" "$resolved_destination")
  BUILT_CMD=("${cmd[@]}")
}

print_verbose_command() {
  local -a cmd=("$@")
  local escaped=""

  printf -v escaped '%q ' "${cmd[@]}"
  print_info "command: ${escaped% }"
}

execute_transfer_pair() {
  local source="$1"
  local destination="$2"
  local src_kind=""
  local src_machine=""
  local src_path=""
  local dst_kind=""
  local dst_machine=""
  local dst_path=""
  local resolved_source=""
  local resolved_destination=""
  local remote_machine=""
  local direction=""
  local start_time=0
  local end_time=0
  local duration=0
  local flags_b64=""
  local rsync_exit=0
  local rsync_log=""
  local gitignore_path=""
  local root_dir=""
  local remote_gitignore_content=""
  local cleanup_git_exclude=false

  parse_endpoint "$source"
  src_kind="$PARSED_KIND"
  src_machine="$PARSED_MACHINE"
  src_path="$PARSED_PATH"

  parse_endpoint "$destination"
  dst_kind="$PARSED_KIND"
  dst_machine="$PARSED_MACHINE"
  dst_path="$PARSED_PATH"

  if [[ "$src_kind" == "multi" ]]; then
    die "Cannot pull from all machines at once"
  fi

  if [[ "$dst_kind" == "multi" ]]; then
    die "Internal error: execute_transfer_pair does not accept multi-target destination"
  fi

  if [[ "$src_kind" == "remote" && "$dst_kind" == "remote" ]]; then
    die "Remote-to-remote transfers are not supported. Pull locally first, then push."
  fi

  if [[ "$src_kind" == "local" && "$dst_kind" == "local" ]]; then
    die "Source and destination are both local. Refusing transfer-to-self."
  fi

  if [[ "$src_kind" == "local" && "$dst_kind" == "remote" ]]; then
    machine_reachable "$dst_machine" || die "Destination '$dst_machine' is not reachable from '$THIS_MACHINE'. Allowed: $CAN_SSH_TO"
    remote_machine="$dst_machine"
    direction="push"
    resolved_source="$(expand_tilde "$src_path")"
    resolved_destination="$(resolve_remote_spec "$dst_machine" "$dst_path")"
  elif [[ "$src_kind" == "remote" && "$dst_kind" == "local" ]]; then
    machine_reachable "$src_machine" || die "Source '$src_machine' is not reachable from '$THIS_MACHINE'. Allowed: $CAN_SSH_TO"
    remote_machine="$src_machine"
    direction="pull"
    resolved_source="$(resolve_remote_spec "$src_machine" "$src_path")"
    resolved_destination="$(expand_tilde "$dst_path")"
  else
    die "Unsupported transfer scenario"
  fi

  GIT_EXCLUDE_FROM_FILE=""
  cleanup_git_exclude=false
  if [[ "$GIT_IGNORE" == true ]]; then
    if [[ "$direction" == "push" ]]; then
      root_dir="${resolved_source%/}"
      if [[ -d "$root_dir" ]]; then
        gitignore_path="$root_dir/.gitignore"
        GIT_EXCLUDE_FROM_FILE="$(gitignore_prepare_exclude_file_local "$gitignore_path")" || return 1
        [[ -n "$GIT_EXCLUDE_FROM_FILE" ]] && cleanup_git_exclude=true
      fi
    elif [[ "$direction" == "pull" ]]; then
      remote_gitignore_content=""
      if remote_gitignore_content="$(fetch_remote_gitignore "$src_machine" "$src_path")"; then
        if [[ -n "$remote_gitignore_content" ]]; then
          GIT_EXCLUDE_FROM_FILE="$(printf '%s' "$remote_gitignore_content" | gitignore_write_exclude_file_from_stdin)" || return 1
          [[ -n "$GIT_EXCLUDE_FROM_FILE" ]] && cleanup_git_exclude=true
        fi
      else
        die "Failed to read remote .gitignore from '$src_machine:$src_path'"
      fi
    fi
  fi

  print_info "$THIS_MACHINE -> ${remote_machine:-local} ($direction): $source -> $destination"

  build_rsync_cmd "$remote_machine" "$resolved_source" "$resolved_destination"

  if [[ "$VERBOSE" == true || "$DRY_RUN" == true ]]; then
    print_verbose_command "${BUILT_CMD[@]}"
  fi

  rsync_log="$(mktemp)"
  start_time="$(date +%s)"
  if [[ "$QUIET" == true ]]; then
    "${BUILT_CMD[@]}" >"$rsync_log" 2> >(tee -a "$rsync_log" >&2)
  else
    "${BUILT_CMD[@]}" > >(tee "$rsync_log") 2> >(tee -a "$rsync_log" >&2)
  fi
  rsync_exit=$?
  end_time="$(date +%s)"
  duration=$((end_time - start_time))

  extract_transfer_stats "$rsync_log"
  rm -f "$rsync_log"
  if [[ "$cleanup_git_exclude" == true && -n "${GIT_EXCLUDE_FROM_FILE:-}" ]]; then
    rm -f "$GIT_EXCLUDE_FROM_FILE" 2>/dev/null || true
  fi

  map_rsync_exit "$rsync_exit"

  if [[ "$DRY_RUN" != true ]]; then
    flags_b64="$(encode_flags_b64 "${TRANSFER_RAW_FLAGS[@]}")"
    record_history "$MAPPED_STATUS" "$source" "$destination" "$STATS_FILES" "$STATS_BYTES" "${duration}s" "$flags_b64"
  fi

  case "$MAPPED_STATUS" in
    OK)
      print_info "status=OK files=$STATS_FILES bytes=$STATS_BYTES duration=${duration}s"
      ;;
    PARTIAL)
      print_warn "status=PARTIAL (rsync exit 23) files=$STATS_FILES bytes=$STATS_BYTES duration=${duration}s"
      ;;
    FAIL)
      print_error "status=FAIL (rsync exit $rsync_exit) files=$STATS_FILES bytes=$STATS_BYTES duration=${duration}s"
      ;;
  esac

  return "$MAPPED_EXIT"
}

parse_transfer_args() {
  local -a positional=()

  DRY_RUN=false
  VERBOSE=false
  QUIET=false
  NO_PROGRESS=false
  UPDATE=false
  GIT_IGNORE=false
  EXCLUDES=()
  EXCLUDE_PROFILES=()
  TRANSFER_RAW_FLAGS=()

  while [[ $# -gt 0 ]]; do
    case "$1" in
      -n|--dry-run)
        DRY_RUN=true
        TRANSFER_RAW_FLAGS+=("$1")
        ;;
      -v|--verbose)
        VERBOSE=true
        TRANSFER_RAW_FLAGS+=("$1")
        ;;
      -q|--quiet)
        QUIET=true
        TRANSFER_RAW_FLAGS+=("$1")
        ;;
      --no-progress)
        NO_PROGRESS=true
        TRANSFER_RAW_FLAGS+=("$1")
        ;;
      --progress)
        NO_PROGRESS=false
        TRANSFER_RAW_FLAGS+=("$1")
        ;;
      --update)
        UPDATE=true
        TRANSFER_RAW_FLAGS+=("$1")
        ;;
      --git)
        GIT_IGNORE=true
        TRANSFER_RAW_FLAGS+=("$1")
        ;;
      --exclude)
        [[ $# -ge 2 ]] || die "--exclude requires a pattern"
        EXCLUDES+=("$2")
        TRANSFER_RAW_FLAGS+=("$1" "$2")
        shift
        ;;
      --exclude=*)
        EXCLUDES+=("${1#*=}")
        TRANSFER_RAW_FLAGS+=("$1")
        ;;
      -ep|--exclude-profile)
        [[ $# -ge 2 ]] || die "$1 requires a profile name"
        EXCLUDE_PROFILES+=("$2")
        TRANSFER_RAW_FLAGS+=("$1" "$2")
        shift
        ;;
      --exclude-profile=*)
        EXCLUDE_PROFILES+=("${1#*=}")
        TRANSFER_RAW_FLAGS+=("$1")
        ;;
      -h|--help)
        print_transfer_help
        exit 0
        ;;
      --)
        shift
        while [[ $# -gt 0 ]]; do
          positional+=("$1")
          shift
        done
        break
        ;;
      -*)
        die "Unknown transfer flag: $1"
        ;;
      *)
        positional+=("$1")
        ;;
    esac
    shift
  done

  [[ ${#positional[@]} -eq 2 ]] || die "Transfer requires <source> <destination>"
  SOURCE_ENDPOINT="${positional[0]}"
  DEST_ENDPOINT="${positional[1]}"
}

cmd_transfer() {
  local src_kind=""
  local dst_kind=""
  local dst_path=""
  local -a targets=()
  local target=""
  local target_dst=""
  local result=0
  local ok_count=0
  local partial_count=0
  local fail_count=0

  load_config
  ensure_runtime_requirements
  parse_transfer_args "$@"

  parse_endpoint "$SOURCE_ENDPOINT"
  src_kind="$PARSED_KIND"

  if [[ "$src_kind" == "multi" ]]; then
    die "Cannot use all: as a source"
  fi

  parse_endpoint "$DEST_ENDPOINT"
  dst_kind="$PARSED_KIND"
  dst_path="$PARSED_PATH"

  if [[ "$dst_kind" == "multi" ]]; then
    [[ "$src_kind" == "local" ]] || die "Broadcast destination requires a local source"
    targets=("${PARSED_TARGETS[@]}")

    [[ ${#targets[@]} -gt 0 ]] || die "No target machines resolved"

    for target in "${targets[@]}"; do
      machine_reachable "$target" || die "Destination '$target' is not reachable from '$THIS_MACHINE'. Allowed: $CAN_SSH_TO"
    done

    for target in "${targets[@]}"; do
      target_dst="$target:$dst_path"
      execute_transfer_pair "$SOURCE_ENDPOINT" "$target_dst"
      result=$?
      case "$result" in
        0) ((ok_count += 1)) ;;
        23) ((partial_count += 1)) ;;
        *) ((fail_count += 1)) ;;
      esac
    done

    print_info "broadcast summary: OK=$ok_count PARTIAL=$partial_count FAIL=$fail_count (${#targets[@]} total)"

    if [[ "$fail_count" -gt 0 ]]; then
      return 1
    fi
    if [[ "$partial_count" -gt 0 ]]; then
      return 23
    fi
    return 0
  fi

  execute_transfer_pair "$SOURCE_ENDPOINT" "$DEST_ENDPOINT"
}

