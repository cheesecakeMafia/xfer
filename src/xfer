        GIT_IGNORE=true
        ;;
      --exclude)
        [[ $# -ge 2 ]] || die "--exclude requires a pattern"
        EXCLUDES+=("$2")
        shift
        ;;
      --exclude=*)
        EXCLUDES+=("${1#*=}")
        ;;
      -ep|--exclude-profile)
        [[ $# -ge 2 ]] || die "$1 requires a profile name"
