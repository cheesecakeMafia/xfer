print_diff_item_line() {
  local line="$1"
  if [[ "$line" == ">f+++++++"* || "$line" == "c"*"+++++++"* ]]; then
    printf '%s%s%s\n' "$C_GREEN" "$line" "$C_RESET"
  elif [[ "$line" == "*deleting "* ]]; then
    printf '%s%s%s\n' "$C_RED" "$line" "$C_RESET"
  elif [[ "$line" == ">"* || "$line" == "c"* ]]; then
    printf '%s%s%s\n' "$C_YELLOW" "$line" "$C_RESET"
  else
    printf '%s\n' "$line"
  fi
}

remote_path_for_ls() {
  local raw_path="$1"
  local safe_tail=""

  if [[ -z "$raw_path" || "$raw_path" == "~" || "$raw_path" == "~/" ]]; then
    printf '%s\n' '\$HOME'
    return
  fi

  if [[ "$raw_path" == "~/"* ]]; then
    safe_tail="$(printf '%q' "${raw_path#"~/"}")"
    printf '%s\n' "\$HOME/$safe_tail"
    return
  fi

  printf '%q\n' "$raw_path"
}

cmd_ls() {
  local endpoint="${1:-}"
  local machine=""
  local path=""
  local user=""
  local ip=""
  local key=""
  local safe_path=""
  local -a ssh_cmd=(ssh)

  [[ -n "$endpoint" ]] || die "xfer ls requires an endpoint"
  if [[ "$endpoint" == "-h" || "$endpoint" == "--help" ]]; then
    print_ls_help
    return 0
  fi

  load_config
  ensure_runtime_requirements

  parse_endpoint "$endpoint"
  [[ "$PARSED_KIND" == "remote" ]] || die "xfer ls requires a remote endpoint (machine:path)"

  machine="$PARSED_MACHINE"
  path="$PARSED_PATH"

  machine_reachable "$machine" || die "Machine '$machine' is not reachable from '$THIS_MACHINE'. Allowed: $CAN_SSH_TO"

  user="$(machine_field "$machine" user)"
  ip="$(machine_field "$machine" ip)"
  key="$(resolve_ssh_key "$machine")"

  [[ -n "$user" ]] || die "Missing config value: ${machine}_user"
  [[ -n "$ip" ]] || die "Missing config value: ${machine}_ip"

  if [[ -n "$key" ]]; then
    [[ -f "$key" ]] || die "SSH key not found for '$machine': $key"
    ssh_cmd+=(-i "$key")
  fi

  ssh_cmd+=("$user@$ip")
  safe_path="$(remote_path_for_ls "$path")"

  "${ssh_cmd[@]}" "ls -ltAh $safe_path"
}

